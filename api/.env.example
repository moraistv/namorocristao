# Porta da API
PORT=3333

# Banco de dados PostgreSQL (Docker)
DATABASE_URL="postgresql://namoro:namoro@localhost:5433/namoro_cristao?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# Google OAuth (Client IDs aceitos para validar o ID token vindo do app)
# Separar por vírgula se houver mais de um (web/android/ios)
GOOGLE_CLIENT_IDS=""

# CORS (origens do painel admin), separadas por vírgula.
# Aceita apenas origens http/https exatas; barra final é normalizada.
# Wildcards, paths, query strings e fragments são rejeitados.
# Em produção a lista não pode ficar vazia.
CORS_ORIGINS="http://localhost:5173"

# Quantos proxies reversos confiáveis existem até o cliente.
# Default: 1 em production; 0 (desativado) fora de production. Máximo: 10.
TRUST_PROXY_HOPS=0

# IA (opcional). A chave do provider selecionado aqui tem precedência sobre o banco.
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
# Chave dedicada para AES-256-GCM das credenciais salvas no banco.
# Em produção é obrigatória, deve ter ao menos 32 caracteres e ser diferente dos JWTs.
# Apenas fora de produção, quando vazia, há fallback em JWT_REFRESH_SECRET.
AI_SECRET_ENCRYPTION_KEY=""
# Timeout por requisição aos providers, entre 1000 e 120000 ms.
AI_REQUEST_TIMEOUT_MS=15000

# Ambiente
NODE_ENV=development
