# Porta da API
PORT=3333

# Banco de dados PostgreSQL (Docker)
DATABASE_URL="postgresql://namoro:namoro@localhost:5433/namoro_cristao?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# Google OAuth (Client IDs aceitos para validar o ID token vindo do app)
# Separar por vírgula se houver mais de um (web/android/ios)
GOOGLE_CLIENT_IDS=""

# CORS (origens do painel admin), separadas por vírgula
CORS_ORIGINS="http://localhost:5173"

# Ambiente
NODE_ENV=development
