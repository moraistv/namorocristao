# Variáveis de PRODUÇÃO — cole estas no Dokploy (aba Environment do projeto Compose).
# NÃO comitar o arquivo .env real com os valores preenchidos.

# Banco de dados
POSTGRES_USER=namoro
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=namoro_cristao

# Segredos JWT (gere com: openssl rand -hex 48)
JWT_ACCESS_SECRET=coloque-um-segredo-forte
JWT_REFRESH_SECRET=coloque-outro-segredo-forte
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google login (opcional) e Push FCM (opcional)
GOOGLE_CLIENT_IDS=
FCM_SERVER_KEY=

# Push via Firebase Cloud Messaging (HTTP v1). Vem do JSON do service account
# (Firebase → Configurações → Contas de serviço → Gerar nova chave privada).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A private_key tem quebras de linha; cole entre aspas com \n (o backend converte).
FIREBASE_PRIVATE_KEY=

# CORS: origem do painel admin (domínio com HTTPS)
CORS_ORIGINS=https://admin.mypair.app

# URL pública da API que o PAINEL vai chamar (injetada no build do Vite)
VITE_API_BASE=https://api.mypair.app/api
